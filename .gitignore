# Merge residue. Deliberately NOT *.patch / *.diff -- depends/patches/,
# contrib/guix/patches/ and src/dashbls/setjmp_patch.diff are tracked build
# inputs, and ignoring them silently breaks `make -C depends` for anyone
# building from a fresh clone.
*.orig
*.rej
*.bak

# Coverage, profiling, crash dumps
*.gcda
*.gcno
*.gcov
coverage/
*.profraw
*.profdata
perf.data
perf.data.old
core
core.*
vgcore.*
callgrind.out.*
massif.out.*
nohup.out

# Node datadirs and runtime state (never belongs in the source tree).
# Root-anchored on purpose: a bare "llmq/" or "blocks/" would silently
# swallow new files under src/llmq/, src/index/, etc.
debug.log
db.log
*.pid
.cookie
wallet.dat
peers.dat
banlist.dat
mempool.dat
fee_estimates.dat
governance.dat
netfulfilled.dat
mncache.dat
/blocks/
/chainstate/
/evodb/
/indexes/
/llmq/
/datadir*/
/regtest/
/testnet3/
/devnet*/
/kerrigan.conf

# Release artifacts (built out-of-tree; never commit binaries or tarballs)
/release/
/*.tar.gz
/*.tar.xz
/*.zip
/*.dmg
/*.exe
/*.AppImage

# OS
.DS_Store
Thumbs.db
upstream

# Qt build residue (generated by moc/uic/rcc/lrelease into the source tree).
# Scoped to src/qt on purpose: a blanket `ui_*` would swallow the TRACKED source
# file src/util/ui_change_type.h. Verified both directions before committing.
src/qt/moc_*.cpp
src/qt/*/moc_*.cpp
src/qt/*.moc
src/qt/forms/ui_*.h
src/qt/qrc_*.cpp
src/qt/*/qrc_*.cpp
src/qt/locale/*.qm

# Generated installer/bundle templates. configure substitutes @abs_top_srcdir@ from
# the tracked .in files at build time, baking the build host's ABSOLUTE path into
# setup.nsi (an identity/path leak if committed). The build regenerates both from
# their .in; only the .in templates are tracked (upstream ignores these too).
/share/setup.nsi
/share/qt/Info.plist

# Host-local release-builder script (not part of the release; may reference
# machine-specific paths).
/.lair-build-release.sh

# Generated test config
test/config.ini
